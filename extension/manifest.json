{
  "manifest_version": 3,
  "name": "C_GUIDE — Ask Anywhere",
  "version": "2.6.0",
  "description": "Pop up a Gemini-powered assistant on any browser tab. Ctrl+Shift+L to open.",
  "permissions": ["tabs", "scripting", "activeTab"],
  "host_permissions": [
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Ask C_GUIDE"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["companion.js"],
      "css": ["companion.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["http://localhost:3000/*", "http://127.0.0.1:3000/*"],
      "js": ["app-bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "exclude_matches": [
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*"
      ],
      "js": ["overlay.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-guide": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Open C_GUIDE (app or extension)"
    }
  }
}
